<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <title>SignTools | Apple ID</title>
    <link rel="icon" type="image/png" href="/favicon.png" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link
      href="https://cdn.jsdelivr.net/npm/bootstrap@5.0.1/dist/css/bootstrap.min.css"
      rel="stylesheet"
      integrity="sha384-+0n0xVW2eSR5OomGNYDnhzAbDsOXxcvSN1TPprVMTNDbiYZCxYbOOl7+AMvyTG2x"
      crossorigin="anonymous"
    />
    <style>
      a.plain,
      a.plain:hover {
        color: inherit;
        text-decoration: none;
      }
    </style>
  </head>
  <body>
    <nav class="navbar navbar-expand navbar-dark bg-dark py-3">
      <div class="container px-4">
        <ol class="breadcrumb bg-transparent py-2 my-0 me-auto text-white">
          <li class="breadcrumb-item"><a class="plain" href="/">SignTools</a></li>
          <li class="breadcrumb-item">Apple ID</li>
        </ol>
      </div>
    </nav>
    <div class="container px-4 py-4" style="max-width: 52rem">
      {{- if .Error }}
      <div class="alert alert-danger" id="error">{{ .Error }}</div>
      {{- end }}
      {{- if .Message }}
      <div class="alert alert-success" id="message">{{ .Message }}</div>
      {{- end }}

      {{- if .TwoFactor }}
      <h4 class="mb-3">Two-factor authentication</h4>
      <p>
        {{- if eq .TwoFactor.Method "sms" }}Enter the code sent by text message to {{ .TwoFactor.Email }}'s phone.
        {{- else }}Enter the code shown on a device signed in to {{ .TwoFactor.Email }}.{{ end }}
      </p>
      <form method="post" action="/appleid/login/{{ .TwoFactor.LoginId }}" class="row g-2 mb-3" id="form2fa">
        <div class="col-auto">
          <input class="form-control" name="code" id="code" inputmode="numeric" autocomplete="one-time-code" placeholder="123456" required autofocus />
        </div>
        <div class="col-auto"><button class="btn btn-primary" type="submit">Verify</button></div>
      </form>
      {{- if .TwoFactor.Phones }}
      <form method="post" action="/appleid/login/{{ .TwoFactor.LoginId }}" class="row g-2">
        <div class="col-auto">
          <select class="form-select" name="sms">
            {{- range .TwoFactor.Phones }}
            <option value="{{ .Id }}">Phone ending in {{ .LastTwoDigits }}</option>
            {{- end }}
          </select>
        </div>
        <div class="col-auto"><button class="btn btn-outline-secondary" type="submit">Send code by SMS instead</button></div>
      </form>
      {{- end }}
      {{- else }}

      <p class="text-muted">
        Log in with an Apple ID that has a paid developer membership. For each team you add, signing registers an
        App ID per app (and app extension), enables the capabilities the app asks for, such as
        <em>Increased Memory Limit</em>, and creates an <em>Apple Development</em> certificate and provisioning
        profiles automatically. The profiles cover the devices registered in the team.
      </p>

      {{- range .Accounts }}
      <div class="card mb-3 account{{ if .Relogin }} border-danger{{ end }}" data-email="{{ .Email }}">
        <div class="card-header d-flex justify-content-between align-items-center">
          <span>
            <strong>{{ .Email }}</strong>{{ if .FirstName }} ({{ .FirstName }}){{ end }}
            {{- if .SessionExpired }}
            <span class="badge bg-danger ms-2 session-status" data-status="expired">Session expired</span>
            {{- else if .TeamsError }}
            <span class="badge bg-warning text-dark ms-2 session-status" data-status="unknown" title="Could not reach Apple; the session itself may be fine">Status unknown</span>
            {{- else }}
            <span class="badge bg-success ms-2 session-status" data-status="valid">Session valid</span>
            {{- end }}
          </span>
          <form method="post" action="/appleid/logout" class="m-0">
            <input type="hidden" name="email" value="{{ .Email }}" />
            <button class="btn btn-sm btn-outline-danger" type="submit">Log out</button>
          </form>
        </div>
        <ul class="list-group list-group-flush">
          {{- if .SessionExpired }}
          <li class="list-group-item">
            <p class="text-danger mb-2">Apple no longer accepts the saved session: {{ .TeamsError }}</p>
            <form method="post" action="/appleid/login" class="row g-2 relogin">
              <input type="hidden" name="email" value="{{ .Email }}" />
              <div class="col-md-8">
                <input class="form-control" type="password" name="password" placeholder="Password for {{ .Email }}" required {{ if .Relogin }}autofocus{{ end }} />
              </div>
              <div class="col-md-4"><button class="btn btn-danger w-100" type="submit">Log in again</button></div>
            </form>
            <p class="small text-muted mt-2 mb-0">Your signing profiles and certificate are kept.</p>
          </li>
          {{- else if .TeamsError }}
          <li class="list-group-item text-danger">Could not list teams: {{ .TeamsError }}</li>
          {{- end }}
          {{- $email := .Email }}
          {{- range .Teams }}
          <li class="list-group-item d-flex justify-content-between align-items-center team" data-team="{{ .Id }}">
            <span>{{ .Name }} <span class="text-muted">· {{ .Id }} · {{ .Type }}</span></span>
            {{- if .ProfileId }}
            <span class="d-flex align-items-center gap-2">
              <span class="badge bg-success">Signing profile added</span>
              <form method="post" action="/profiles/{{ .ProfileId }}/delete" class="m-0"
                onsubmit="return confirm('Remove this team from the signing profiles? The Apple ID stays logged in.')">
                <input type="hidden" name="return" value="appleid" />
                <button class="btn btn-sm btn-outline-danger" type="submit">Remove</button>
              </form>
            </span>
            {{- else }}
            <form method="post" action="/appleid/profiles" class="d-flex align-items-center gap-3 m-0">
              <input type="hidden" name="email" value="{{ $email }}" />
              <input type="hidden" name="team_id" value="{{ .Id }}" />
              <input type="hidden" name="team_name" value="{{ .Name }}" />
              <div class="form-check m-0" title="When the team has no room for another development certificate, revoke an old one (Impactor asks the same)">
                <input class="form-check-input" type="checkbox" name="cert_reset" id="reset-{{ .Id }}" />
                <label class="form-check-label small" for="reset-{{ .Id }}">allow certificate reset</label>
              </div>
              <button class="btn btn-sm btn-primary" type="submit">Use for signing</button>
            </form>
            {{- end }}
          </li>
          {{- end }}
        </ul>
      </div>
      {{- end }}

      <h5 class="mt-4">Log in</h5>
      <form method="post" action="/appleid/login" class="row g-2" id="formLogin">
        <div class="col-md-5"><input class="form-control" type="email" name="email" placeholder="Apple ID" value="{{ .LoginEmail }}" required /></div>
        <div class="col-md-4"><input class="form-control" type="password" name="password" placeholder="Password" required /></div>
        <div class="col-md-3"><button class="btn btn-primary w-100" type="submit">Log in</button></div>
      </form>
      <p class="small text-muted mt-2">
        The password goes to Apple only (SRP); only the resulting session token is stored on this server.
      </p>
      {{- end }}
    </div>
  </body>
</html>
