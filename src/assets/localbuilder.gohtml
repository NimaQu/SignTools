<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <title>SignTools | Signing logs</title>
    <link rel="icon" type="image/png" href="/favicon.png" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link
      href="https://cdn.jsdelivr.net/npm/bootstrap@5.0.1/dist/css/bootstrap.min.css"
      rel="stylesheet"
      integrity="sha384-+0n0xVW2eSR5OomGNYDnhzAbDsOXxcvSN1TPprVMTNDbiYZCxYbOOl7+AMvyTG2x"
      crossorigin="anonymous"
    />
  </head>
  <body>
    <nav class="navbar navbar-expand navbar-dark bg-dark py-3">
      <div class="container px-4">
        <ol class="breadcrumb bg-transparent py-2 my-0 me-auto text-white">
          <li class="breadcrumb-item"><a class="text-white text-decoration-none" href="/">SignTools</a></li>
          <li class="breadcrumb-item">Signing logs</li>
        </ol>
      </div>
    </nav>
    <div class="container px-4 py-4">
      {{- if not . }}
      <p class="text-muted">No signing jobs yet.</p>
      {{- end }}
      {{- range . }}
      <details class="mb-3" {{ if .Running }}open{{ end }}>
        <summary>
          {{ .Started.Format "2006-01-02 15:04:05" }} ·
          {{ if .Running }}<span class="text-primary">running</span>
          {{ else if .Failed }}<span class="text-danger">failed</span>
          {{ else }}<span class="text-success">done</span>{{ end }}
          {{ if not .Running }}· {{ .Duration }}{{ end }}
        </summary>
        <pre class="bg-light p-3 mt-2 small" style="white-space: pre-wrap">{{ .Output }}</pre>
      </details>
      {{- end }}
    </div>
  </body>
</html>
